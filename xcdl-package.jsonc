{
  "$schema": "https://xpack.github.io/xcdl/schemas/xcdl-2.0.0.json",
  "minimumXcdlRequired": "2.0.0",
  "license": "MIT",
  "copyright": "Copyright (c) 2022-2026 Liviu Ionescu. All rights reserved.",
  "cdlComponents": [
    {
      "id": "micro-os-plus.architectures.riscv",
      "alias": "micro-os-plus.architecture",
      "display": "RISC-V architecture",
      "description": "The RISC-V architecture definitions, for 32/64-bit devices",
      "publicIncludeFolders": [
        "include"
      ],
      "sourceFiles": [
        "src/semihosting.cpp",
        "src/show-cpuid.cpp"
      ],
      "dependencies": [
        // This introduces a circular dependency.
        // "micro-os-plus.semihosting"
      ],
      "implementedInterfaces": [
        "micro-os-plus.architecture"
      ],
      "generatedFile": {
        "type": "c-header",
        "filePath": "{{buildFolderPath}}/generated/include/micro-os-plus/architecture-defines.h"
      },
      // "defaultDefine": "MICRO_OS_PLUS_ARCHITECTURES_RISCV_ENABLED"
      "cdlComponents": [
        {
          "id": "debugger-entry-point",
          "display": "Debugger entry point",
          "description": "The ELF entry point when the application is started by a debugger",
          "sourceFiles": [
            "src/debugger-entry-point.S"
          ],
          // "defaultDefine": "MICRO_OS_PLUS_ARCHITECTURES_RISCV_DEBUGGER_ENTRY_POINT_ENABLED"
        },
        {
          "id": "reset-entry",
          "display": "Reset entry",
          "description": "The reset code executed when the system is reset",
          "sourceFiles": [
            "src/reset-entry.S"
          ]
          // "defaultDefine": "MICRO_OS_PLUS_ARCHITECTURES_RISCV_RESET_ENTRY_ENABLED"
        },
      ]
    }
  ]
}